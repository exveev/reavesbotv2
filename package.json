{
  "name": "reavesbot",
  "version": "1.0.0",
  "scripts": {
    "start": "node server/index.js",
    "build": "cd client && npm install && npm run build",
    "dev": "concurrently \"nodemon server/index.js\" \"cd client && npm start\""
  },
  "dependencies": {
    "axios": "^1.6.0",
    "concurrently": "^8.2.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
